# Server
PORT=3001
NODE_ENV=production

# PostgreSQL (Docker service name)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/notification_api?schema=public"

# RabbitMQ (Docker service name)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=notifications
